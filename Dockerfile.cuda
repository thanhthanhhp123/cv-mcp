# CUDA image. Needs the NVIDIA Container Toolkit on the host (`--gpus all`).
FROM nvidia/cuda:12.1.1-runtime-ubuntu22.04

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive \
    VISION_MCP_DEVICE=cuda

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 python3-pip libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
RUN uv pip install --system --no-cache .

COPY scripts ./scripts
RUN python3.11 scripts/download_models.py

ENTRYPOINT ["python3.11", "-m", "vision_mcp.server"]
